# ──────────────────────────────────────────────────────────────
# NossaCarta — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite .env.local. NUNCA exponha SUPABASE_SERVICE_ROLE_KEY
# nem outras chaves sem prefixo NEXT_PUBLIC_ no client-side.
# ──────────────────────────────────────────────────────────────

# ─── Supabase ─────────────────────────────────────────────────
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — somente server-side (route handlers, server actions, webhooks)
SUPABASE_SERVICE_ROLE_KEY=

# Settings → Database → Connection string (Session pooler, modo "Transaction")
# Use para migrations CLI; aplicação roda via SDK, não precisa.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron Vercel ──────────────────────────────────────────────
# OBRIGATORIO em producao — sem ele /api/cron/expirar-bilhete retorna 401.
# Gere com: openssl rand -hex 32
# Em dev pode ficar vazio (cron nao roda localmente via Vercel).
CRON_SECRET=

# ─── AbacatePay ───────────────────────────────────────────────
# https://www.abacatepay.com/dashboard → API Keys
# Dev: abc_dev_... | Prod: abc_live_...
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_PUBLIC_KEY=
# Dashboard → Produtos → copiar ID de cada produto criado
ABACATEPAY_PRODUCT_BILHETE=
ABACATEPAY_PRODUCT_ETERNO=

# ─── Meta Ads (opcional — só ativar após LGPD consent configurado) ───
# Facebook → Gerenciador de Eventos → Pixel → Configurações → ID do Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Resend (preencher no passo 5) ────────────────────────────
RESEND_API_KEY=
RESEND_FROM=ola@nossacarta.love

# ─── Spotify (Web API Client Credentials) ─────────────────────
# https://developer.spotify.com/dashboard → Create App
# Não precisa redirect URI (uso só Client Credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
